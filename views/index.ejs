<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>UBL Forge</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-light">

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow border-0">

                <div class="card-body p-5">

                    <div class="text-center mb-5">

                        <h1 class="fw-bold">

                            <i class="bi bi-file-earmark-code-fill text-primary me-2"></i>

                            UBL Forge

                        </h1>

                        <p class="text-muted fs-5 mt-3">

                            CSV dosyalarınızı saniyeler içerisinde
                            UBL XML belgelerine dönüştürün.

                        </p>

                    </div>

                    <form action="/upload"
                          id="uploadForm"
                          method="POST"
                          enctype="multipart/form-data">

                        <div class="mb-4">

                            <label
                                for="csvFile"
                                class="form-label fw-semibold">

                                CSV Dosyası

                            </label>

                            <input
    type="file"
    id="csvFile"
    name="csvFile"
    accept=".csv"
    class="d-none"
    required>

<div
    id="dropZone"
    class="drop-zone border border-2 rounded-4 p-5 text-center bg-light">

    <i
        id="uploadIcon"
        class="bi bi-cloud-arrow-up display-2 text-primary">
    </i>

    <h4 class="mt-3">

        CSV Dosyanızı Buraya Sürükleyin

    </h4>

    <p class="text-muted">

        veya aşağıdaki butona tıklayarak dosya seçin

    </p>

    <button
        type="button"
        id="browseBtn"
        class="btn btn-primary btn-lg">

        <i class="bi bi-folder2-open me-2"></i>

        Dosya Seç

    </button>

</div>

<div class="row text-center mt-4 g-3">
<div class="col-md-3"><div class="border rounded-3 p-3 h-100"><div>📄</div><small>CSV Desteği</small></div></div>
<div class="col-md-3"><div class="border rounded-3 p-3 h-100"><div>⚡</div><small>UBL XML</small></div></div>
<div class="col-md-3"><div class="border rounded-3 p-3 h-100"><div>🔒</div><small>Güvenli</small></div></div>
<div class="col-md-3"><div class="border rounded-3 p-3 h-100"><div>🚀</div><small>Hızlı</small></div></div>
</div>

<div
    id="fileInfo"
    class="alert alert-success mt-3 d-none">

    <div class="d-flex justify-content-between align-items-center flex-wrap">

        <div>

            <i class="bi bi-check-circle-fill me-2"></i>

            <strong id="fileName">

                Henüz dosya seçilmedi

            </strong>

        </div>

        <small
            id="fileSize"
            class="text-muted">

        </small>

    </div>

</div>
                        </div>

                        <div class="d-grid">

                            <button
    id="submitBtn"
    class="btn btn-success btn-lg"
    type="submit">

    <span id="btnContent">

        <i class="bi bi-gear-fill me-2"></i>

        XML Oluştur

    </span>

</button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="/js/upload.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<!-- Loading Overlay -->

<div
    id="loadingOverlay"
    class="loading-overlay position-fixed top-0 start-0 w-100 h-100 d-none justify-content-center align-items-center">

    <div class="card border-0 shadow-lg">

        <div class="card-body text-center p-5">

            <div class="loading-spinner spinner-border text-primary mb-4">

            </div>
            <div class="loading-progress progress mt-4">

    <div
    id="loadingProgress"
    class="loading-progress-bar progress-bar progress-bar-striped progress-bar-animated">

    </div>

</div>
            <h4 class="fw-bold">

                CSV İşleniyor...

            </h4>

            <div class="mt-4">

    <div
        id="loadingStep"
        class="fw-semibold text-primary fs-5">

        CSV okunuyor...

    </div>

    <small class="text-muted">

        İşlem tamamlanana kadar lütfen sayfayı kapatmayın.

    </small>

</div>

        </div>

    </div>

</div>
</body>

</html>