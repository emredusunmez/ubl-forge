<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="UTF-8">

    <title>UBL Forge</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-light">

<div class="container mt-5 mb-5">

    <div class="card shadow">

        <div class="card-header bg-white py-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap">

        <div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-file-earmark-code-fill text-primary me-2"></i>
                UBL Forge
            </h2>

            <p class="text-muted mb-0">
                CSV dosyanız başarıyla işlendi.
                Oluşturulan UBL XML belgelerini görüntüleyebilir,
                kopyalayabilir veya indirebilirsiniz.
            </p>

        </div>

        <div class="text-end mt-3 mt-md-0">

            <span class="badge bg-success fs-6 px-3 py-2">

                <i class="bi bi-check-circle-fill me-1"></i>

                Başarılı

            </span>

        </div>

    </div>

</div>

        <div class="card-body">

            <div class="alert alert-success">

                <strong><%= fileName %></strong> başarıyla yüklendi.

            </div>

            <!-- İşlem Özeti -->

           <!-- Dashboard -->

<div class="row g-3 mb-4">

    <div class="col-md-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body text-center">

                <i class="bi bi-file-earmark-code-fill display-5 text-primary"></i>

                <h2 class="fw-bold mt-3 mb-1">
                    <%= summary.totalXml %>
                </h2>

                <div class="text-muted">
                    Oluşturulan XML
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body text-center">

                <i class="bi bi-table display-5 text-success"></i>

                <h2 class="fw-bold mt-3 mb-1">
                    <%= summary.totalRows %>
                </h2>

                <div class="text-muted">
                    CSV Satırı
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body text-center">

                <i class="bi bi-folder-fill display-5 text-warning"></i>

                <h2 class="fw-bold mt-3 mb-1">
                    <%= summary.totalFiles %>
                </h2>

                <div class="text-muted">
                    Oluşturulan Dosya
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body text-center">

                <i class="bi bi-clock-history display-5 text-info"></i>

                <h5 class="fw-bold mt-3 mb-1">
                    <%= summary.uploadTime %>
                </h5>

                <div class="text-muted">
                    İşlem Zamanı
                </div>

            </div>

        </div>

    </div>

</div>

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body d-flex align-items-center">

        <div class="me-3">

            <i class="bi bi-file-earmark-arrow-up-fill text-primary fs-1"></i>

        </div>

        <div>

            <div class="text-muted small">

                Kaynak Dosya

            </div>

            <div class="fw-bold fs-5">

                <%= fileName %>

            </div>

        </div>

    </div>

</div>

          <!-- Toolbar -->

<!-- Toolbar -->

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div class="d-flex align-items-center gap-2">

                <button
                    id="csvToggleBtn"
                    class="btn btn-primary"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#csvPreview">

                    <i id="csvArrow" class="bi bi-chevron-right me-2"></i>

                    <i id="csvFolder" class="bi bi-folder2 me-2"></i>

                    CSV Önizleme

                </button>

                <span class="badge bg-light text-dark border fs-6">

                    <i class="bi bi-table me-1"></i>

                    <%= rows.length %> Satır

                </span>

            </div>

            <div class="d-flex gap-2">

                <% if (generatedFiles.length === 1) { %>

                    <a
                        href="/download/<%= generatedFiles[0].id %>"
                        class="btn btn-success">

                        <i class="bi bi-download me-2"></i>

                        XML İndir

                    </a>

                <% } else { %>

                    <a
                        href="/download/all"
                        class="btn btn-success">

                        <i class="bi bi-file-earmark-zip me-2"></i>

                        ZIP İndir

                    </a>

                <% } %>

            </div>

        </div>

    </div>

</div>

<div class="collapse mb-4" id="csvPreview">

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-light">

            <strong>

                <i class="bi bi-table me-2"></i>

                CSV İçeriği

            </strong>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-striped align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <% Object.keys(rows[0]).forEach(column => { %>

                                <th><%= column %></th>

                            <% }) %>

                        </tr>

                    </thead>

                    <tbody>

                        <% rows.forEach(row => { %>

                            <tr>

                                <% Object.values(row).forEach(value => { %>

                                    <td><%= value %></td>

                                <% }) %>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<hr>

            <% if (generatedFiles.length === 1) { %>

                <h3>Oluşturulan XML</h3>

            <% } else { %>

                <h3>Oluşturulan XML Dosyaları</h3>

            <% } %>
<!-- Search Area -->

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <input
            type="text"
            id="searchInput"
            class="form-control form-control-lg"
            placeholder="🔍 Belge Ara...">

        <div class="d-flex justify-content-between mt-3">

            <span>

                Toplam:

                <strong id="totalCount">

                    <%= generatedFiles.length %>

                </strong>

                XML

            </span>

            <span>

                Gösterilen:

                <strong id="visibleCount">

                    <%= generatedFiles.length %>

                </strong>

                XML

            </span>

        </div>

    </div>

</div>
            <% generatedFiles.forEach((file, index) => { %>

                <div
    class="card mt-3 xml-card"
    data-file-name="<%= file.fileName.toLowerCase() %>">

                    <div class="card-header d-flex justify-content-between align-items-center">

                        <div
    class="d-flex align-items-center flex-grow-1"
    role="button"
    data-bs-toggle="collapse"
    data-bs-target="#xmlCollapse-<%= index %>"
    aria-expanded="false"
    style="cursor:pointer;">

    <i
        id="headerArrow-<%= index %>"
        class="bi bi-chevron-right me-3">
    </i>

    <strong>
        📄 <%= file.fileName %>
    </strong>

</div>

                        <div>

                            <button
    class="btn btn-outline-primary btn-sm me-2"
    onclick="event.preventDefault(); event.stopPropagation(); copyXml('xml-<%= index %>', this); return false;">

    📋 Kopyala

</button>

                            <a
    href="/download/<%= file.id %>"
    class="btn btn-outline-success btn-sm"
    onclick="event.stopPropagation();">

    📥 İndir

</a>

                        </div>

                    </div>

                    <div class="card-body">

   

    <div
        class="collapse"
        id="xmlCollapse-<%= index %>">

        <pre
            id="xml-<%= index %>"
            class="mb-0"><%= file.xml %></pre>

    </div>

</div>

                </div>

            <% }) %>

        </div>

    </div>

</div>




<script src="/js/preview.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>