<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="UTF-8">

    <title>CSV Önizleme</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-light">

<div class="container mt-5 mb-5">

    <div class="card shadow">

        <div class="card-header">

            <h2>📄 UBL Converter</h2>

        </div>

        <div class="card-body">

            <div class="alert alert-success">

                <strong><%= fileName %></strong> başarıyla yüklendi.

            </div>

            <table class="table table-bordered table-striped">

                <thead>

                <tr>

                    <% Object.keys(rows[0]).forEach(column => { %>

                        <th><%= column %></th>

                    <% }) %>

                </tr>

                </thead>

                <tbody>

                <% rows.forEach(row => { %>

                    <tr>

                        <% Object.values(row).forEach(value => { %>

                            <td><%= value %></td>

                        <% }) %>

                    </tr>

                <% }) %>

                </tbody>

            </table>

            <% if (generatedFiles.length === 1) { %>

             <a
            href="/download/<%= generatedFiles[0].id %>"
            class="btn btn-success">

            📥 XML İndir

            </a>

            <% } else { %>

            <button class="btn btn-success" disabled>

            📦 ZIP İndir (Yakında)

            </button>

            <% } %>
            
            <hr>

            <% if (generatedFiles.length === 1) { %>

                <h3>Oluşturulan XML</h3>

                <div class="card mt-3">

                    <div class="card-header d-flex justify-content-between align-items-center">

                        <strong><%= generatedFiles[0].fileName %></strong>

                    </div>

                    <div class="card-body">

                        <pre class="mb-0"><%= generatedFiles[0].xml %></pre>

                    </div>

                </div>

            <% } else { %>

                <h3>Oluşturulan XML Dosyaları</h3>

                <% generatedFiles.forEach(file => { %>

                    <div class="card mt-3">

                        <div class="card-header d-flex justify-content-between align-items-center">

                            <strong><%= file.fileName %></strong>

                        </div>

                        <div class="card-body">

                            <pre class="mb-0"><%= file.xml %></pre>

                        </div>

                    </div>

                <% }) %>

            <% } %>

        </div>

    </div>

</div>

</body>

</html>